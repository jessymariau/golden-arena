# Get a key at https://openrouter.ai/keys
# Without it, Golden Arena runs in DEMO MODE — scripted sparring partners with
# distinct personalities — so the whole app works with zero setup and zero spend.
#
# You do NOT need this on a public deployment. A visitor can click the mode pill
# and bring their OWN OpenRouter key: it stays in their browser, travels in an
# X-OpenRouter-Key header for their matches only, is never stored or logged, and
# is billed to them. Set the variable below only when the HOUSE is paying.
OPENROUTER_API_KEY=

# Hard daily cap on live model calls (protects your key on a public URL).
DAILY_CALL_BUDGET=400

PORT=3001
