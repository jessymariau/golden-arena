# Provisions node+npm in BOTH the workspace and the deployment container.
# Without it the Autoscale deploy dies with `sh: 1: npm: not found` (exit 127)
# even though the build step succeeds.
modules = ["nodejs-20"]

run = "npm start"
entrypoint = "server.js"

[env]
XDG_CONFIG_HOME = "/home/runner/.config"

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
run = ["sh", "-c", "npm start"]

[[ports]]
localPort = 3001
externalPort = 80
